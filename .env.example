# JARVIS Core Service Environment Configuration
HOST=127.0.0.1
PORT=8765
AUTH_TOKEN=jarvis-local-dev-token
DEBUG=false

# Runtime Data Directory (%APPDATA%\JARVIS or dev fallback .data)
JARVIS_DATA_DIR=

# Ollama Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Model Tiers
TIER1_MODEL=ollama/llama3.2
TIER2_MODEL=gemini/gemini-1.5-flash
TIER3_MODEL=gemini/gemini-1.5-pro

# Cloud API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Langfuse Observability
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
